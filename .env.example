X_USERNAME=your_twitter_username
X_PASSWORD=your_twitter_password
X_EMAIL=your_email@example.com
X_EMAIL_PASSWORD=your_email_password
# Only if your X account uses an authenticator app (TOTP) for 2FA.
# This is the base32 "setup key" shown when configuring 2FA, NOT the 6-digit code.
X_MFA_SECRET=
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-flash
OBSIDIAN_VAULT_PATH=~/Library/Mobile Documents/iCloud~md~obsidian/Documents/all/sources/
DB_PATH=~/.local/share/xreminder/xreminder.db
FETCH_LIMIT=20
